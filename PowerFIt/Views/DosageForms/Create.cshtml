@model PowerFIt.Models.DosageForm

@{
    ViewData["Title"] = "Добавяне на форма";
}

<div class="form-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Добавяне на нова форма</h1>
            <p class="page-subtitle">
                Създайте нов тип форма за продуктите в системата.
            </p>
        </div>
    </div>

    <div class="product-form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div class="form-field form-field-full">
                    <label asp-for="Name" class="form-label">Име на форма</label>
                    <input asp-for="Name" class="form-control custom-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" rows="4" class="form-control custom-input custom-textarea"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn hero-btn-primary">Запази формата</button>
                <a asp-action="Index" class="btn hero-btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}