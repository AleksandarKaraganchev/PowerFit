@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@using PowerFIt.Models
@inject SignInManager<Customer> SignInManager
@inject UserManager<Customer> UserManager

@{
    var cartCount = 0;

    var sessionData = Context.Session.GetString("CheckoutItems");

    if (!string.IsNullOrEmpty(sessionData))
    {
        var items = JsonSerializer.Deserialize<List<CheckoutItem>>(sessionData);
        cartCount = items?.Sum(x => x.Quantity) ?? 0;
    }
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Сила и действие</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    Сила и действие
                </a>

                <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Продукти</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Категории
                            </a>
                            <ul class="dropdown-menu custom-dropdown" aria-labelledby="categoriesDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                                        Всички категории
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider custom-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryName="Протеини">
                                        Протеини
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryName="Fat-burners">
                                        Fat-burners
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryName="Креатин">
                                        Креатин
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryName="BCAA">
                                        BCAA
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryName="EAA">
                                        EAA
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryName="Здравословни храни">
                                        Здравословни храни
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DosageForms" asp-action="Index">Форми</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">За нас</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Контакти</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Админ панел
                                </a>
                                <ul class="dropdown-menu custom-dropdown" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Products" asp-action="Create">Добави продукт</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Products" asp-action="Index">Управление на продукти</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Categories" asp-action="Index">Категории</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="DosageForms" asp-action="Index">Форми</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Orders" asp-action="Index">Поръчки</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-user profile-link" asp-controller="Profile" asp-action="Index">
                                    Здравей, @User.Identity?.Name
                                </a>
                            </li>

                            <li class="nav-item">
                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="btn nav-btn-outline">Изход</button>
                                </form>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link cart-link" asp-controller="Checkout" asp-action="Index">
                                    🛒 Количка
                                    @if (cartCount > 0)
                                    {
                                        <span class="cart-badge">@cartCount</span>
                                    }
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn nav-btn-outline me-2" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn nav-btn-solid" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="page-wrapper">
        <div class="container">
            <div class="content-shell">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand-block">
                    <h4>Сила и действие</h4>
                    <p>
                        Онлайн магазин за фитнес добавки с удобна система за продукти,
                        категории, форми и поръчки.
                    </p>
                </div>

                <div class="footer-links-block">
                    <h5>Навигация</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Начало</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Продукти</a></li>
                        <li><a asp-controller="Categories" asp-action="Index">Категории</a></li>
                        <li><a asp-controller="DosageForms" asp-action="Index">Форми</a></li>
                    </ul>
                </div>

                <div class="footer-links-block">
                    <h5>Потребител</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Checkout" asp-action="Index">Количка</a></li>
                        <li><a asp-controller="Orders" asp-action="Index">Поръчки</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Login">Вход</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register">Регистрация</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year - Сила и действие</span>
                <span>PowerFit</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>