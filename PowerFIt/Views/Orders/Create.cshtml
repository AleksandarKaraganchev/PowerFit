@model PowerFIt.Models.Order

@{
    ViewData["Title"] = "Създаване на поръчка";
}

<div class="form-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Създаване на поръчка</h1>
            <p class="page-subtitle">
                Създай нова поръчка за избран продукт.
            </p>
        </div>
    </div>

    <div class="product-form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="ProductId" class="form-label">Продукт</label>
                    <select asp-for="ProductId" class="form-select custom-input" asp-items="ViewBag.ProductId"></select>
                    <span asp-validation-for="ProductId" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Quantity" class="form-label">Количество</label>
                    <input asp-for="Quantity" class="form-control custom-input" min="1" value="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" rows="5" class="form-control custom-input custom-textarea"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn hero-btn-primary">Създай поръчката</button>
                <a asp-action="Index" class="btn hero-btn-secondary">Назад към поръчките</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}