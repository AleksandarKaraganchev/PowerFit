@model PowerFIt.Models.Order

@{
    ViewData["Title"] = "Детайли за поръчка";
}

<div class="details-page">
    <div class="details-header">
        <div>
            <div class="details-badge">
                Поръчка #@Model.Id
            </div>

            <h1 class="details-title">
                @(Model.Products?.Name ?? "Продукт")
            </h1>

            <p class="details-subtitle">
                Подробна информация за избраната поръчка.
            </p>
        </div>
    </div>

    <div class="row g-4 align-items-stretch">
        <div class="col-lg-5">
            <div class="details-image-card">
                @if (!string.IsNullOrWhiteSpace(Model.Products?.Image))
                {
                    <img src="@Model.Products.Image" alt="@Model.Products.Name" class="details-product-image" />
                }
                else
                {
                    <img src="/images/no-image.png" alt="Няма изображение" class="details-product-image" />
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="details-info-card">
                <h2>Информация за поръчката</h2>

                <div class="details-info-grid">
                    <div class="details-info-item">
                        <span>Продукт</span>
                        <strong>@(Model.Products?.Name ?? "-")</strong>
                    </div>

                    <div class="details-info-item">
                        <span>Количество</span>
                        <strong>@Model.Quantity</strong>
                    </div>

                    <div class="details-info-item">
                        <span>Потребител</span>
                        <strong>@(Model.Customers?.UserName ?? "-")</strong>
                    </div>

                    <div class="details-info-item">
                        <span>Дата</span>
                        <strong>@Model.OrderDate</strong>
                    </div>
                </div>

                <div class="details-description-box">
                    <h3>Описание</h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p>Няма описание за тази поръчка.</p>
                    }
                </div>

                <div class="details-actions">
                    <a asp-action="Index" class="btn hero-btn-secondary">Назад към поръчките</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn product-btn-warning">Редакция</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn product-btn-danger">Изтрий</a>
                </div>
            </div>
        </div>
    </div>
</div>