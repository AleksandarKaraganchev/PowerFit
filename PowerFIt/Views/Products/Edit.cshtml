@model PowerFIt.Models.Product

@{
    ViewData["Title"] = "Редакция на продукт";
}

<div class="form-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Редакция на продукт</h1>
            <p class="page-subtitle">
                Променете информацията за избрания продукт.
            </p>
        </div>
    </div>

    <div class="product-form-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control custom-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control custom-input" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="CategoryId" class="form-label">Категория</label>
                    <select asp-for="CategoryId" class="form-select custom-input" asp-items="ViewBag.CategoryId"></select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="DosageFormId" class="form-label">Форма</label>
                    <select asp-for="DosageFormId" class="form-select custom-input" asp-items="ViewBag.DosageFormId"></select>
                    <span asp-validation-for="DosageFormId" class="text-danger"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Image" class="form-label">Снимка (URL)</label>
                    <input asp-for="Image" class="form-control custom-input" />
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="5" class="form-control custom-input custom-textarea"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-field form-field-full">
                    <label asp-for="MeasureUnit" class="form-label"></label>
                    <textarea asp-for="MeasureUnit" rows="5" class="form-control custom-input custom-textarea"></textarea>
                    <span asp-validation-for="MeasureUnit" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Quantity" class="form-label">Наличност</label>
                    <input asp-for="Quantity" class="form-control custom-input" min="0" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="form-field form-field-full">
                    <label asp-for="RecommendedFor" class="form-label"></label>
                    <textarea asp-for="RecommendedFor" rows="5" class="form-control custom-input custom-textarea"></textarea>
                    <span asp-validation-for="RecommendedFor" class="text-danger"></span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Image))
            {
                <div class="edit-image-preview">
                    <p class="preview-label">Текуща снимка</p>
                    <img src="@Model.Image" alt="@Model.Name" class="edit-preview-image" />
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn hero-btn-primary">Запази промените</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn product-btn-secondary">Към детайли</a>
                <a asp-action="Index" class="btn hero-btn-secondary">Назад към продуктите</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}