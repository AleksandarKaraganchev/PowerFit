@model PowerFIt.Models.Order

@{
    ViewData["Title"] = "Изтриване на поръчка";
}

<div class="delete-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Изтриване на поръчка</h1>
            <p class="page-subtitle">
                Потвърди изтриването на избраната поръчка.
            </p>
        </div>
    </div>

    <div class="delete-card">
        <div class="delete-warning-box">
            <div class="delete-warning-title">Внимание</div>
            <p>
                Сигурен ли си, че искаш да изтриеш тази поръчка? Това действие не може да бъде отменено.
            </p>
        </div>

        <div class="delete-info-card">
            <h2>Информация за поръчката</h2>

            <div class="delete-info-grid">
                <div class="delete-info-item">
                    <span>Продукт</span>
                    <strong>@(Model.Products?.Name ?? "-")</strong>
                </div>

                <div class="delete-info-item">
                    <span>Количество</span>
                    <strong>@Model.Quantity</strong>
                </div>

                <div class="delete-info-item">
                    <span>Дата</span>
                    <strong>@Model.OrderDate</strong>
                </div>

                <div class="delete-info-item">
                    <span>Описание</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</strong>
                </div>
            </div>

            <form asp-action="Delete" class="delete-actions">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn product-btn-danger">Изтрий поръчката</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn product-btn-secondary">Към детайли</a>
                <a asp-action="Index" class="btn hero-btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>