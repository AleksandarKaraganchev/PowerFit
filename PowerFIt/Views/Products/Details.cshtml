@model PowerFIt.Models.Product

@{
    ViewData["Title"] = "Детайли за продукт";
}

<div class="details-page">
    <div class="details-header">
        <div>
            <div class="details-badge">
                @(Model.Categories?.Name ?? "Категория")
            </div>

            <h1 class="details-title">@Model.Name</h1>
            @if (Model.Quantity <= 5 && Model.Quantity > 0)
            {
                <div class="low-stock-badge">
                    ⚠ Остават само @Model.Quantity бр.!
                </div>
            }
            <p class="details-subtitle">
                Подробна информация за избрания продукт.
            </p>
        </div>

        <div class="details-price-box">
            <span class="details-price-label">Цена</span>
            <div class="details-price">@Model.Price.ToString("0.00") €</div>
        </div>
    </div>

    <div class="row g-4 align-items-stretch">
        <div class="col-lg-5">
            <div class="details-image-card">

                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Name" class="details-product-image" />
                }
                else
                {
                    <img src="/images/no-image.png" alt="Няма изображение" class="details-product-image" />
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="details-info-card">
                <h2>Информация за продукта</h2>

                <div class="details-info-grid">
                    <div class="details-info-item">
                        <span>Име</span>
                        <strong>@Model.Name</strong>
                    </div>
                 

                    <div class="details-info-item">
                        <span>Категория</span>
                        <strong>@(Model.Categories?.Name ?? "-")</strong>
                    </div>

                    <div class="details-info-item">
                        <span>Форма</span>
                        <strong>@(Model.DosageForms?.Name ?? "-")</strong>
                    </div>
                    <div class="details-info-item">
                        <span>Предназначение</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.RecommendedFor)
                                                        ? "Не е посочено"
                                                        : Model.RecommendedFor)
                        </strong>
                    </div>
                    <div class="details-info-item">
                        <span>Наличност</span>
                        <strong>@Model.Quantity бр.</strong>
                    </div>
                    <div class="details-info-item">
                        <span>Цена</span>
                        <strong>@Model.Price.ToString("0.00") €</strong>
                    </div>

                </div>

                <div class="details-description-box">
                    <h3>Описание</h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p>Няма добавено описание за този продукт.</p>
                    }
                </div>

                <div class="details-actions">
                    <div class="details-actions">

                        <a asp-action="Index" class="btn hero-btn-secondary">
                            Назад към продуктите
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            if (Model.Quantity > 0)
                            {
                                <form asp-controller="Checkout" asp-action="Add" method="post" class="order-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.Id" />

                                    <div class="quantity-control">
                                        <label>Количество</label>
                                        <div class="quantity-box">
                                            <button type="button" class="qty-btn" onclick="decreaseQty()">-</button>

                                            <input type="number"
                                                   id="quantityInput"
                                                   name="quantity"
                                                   value="1"
                                                   min="1"
                                                   max="@Model.Quantity"
                                                   class="quantity-input" />

                                            <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn hero-btn-primary">
                                        Поръчай
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn product-btn-danger" disabled>
                                    Продуктът е изчерпан
                                </button>
                            }
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn product-btn-warning">Редакция</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn product-btn-danger">Изтрий</a>
                            if (Model.Quantity > 0)
                            {
                                <form asp-controller="Checkout" asp-action="Add" method="post" class="order-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.Id" />

                                    <div class="quantity-control">
                                        <label>Количество</label>
                                        <div class="quantity-box">
                                            <button type="button" class="qty-btn" onclick="decreaseQty()">-</button>

                                            <input type="number"
                                                   id="quantityInput"
                                                   name="quantity"
                                                   value="1"
                                                   min="1"
                                                   max="@Model.Quantity"
                                                   class="quantity-input" />

                                            <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn hero-btn-primary">
                                        Поръчай
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn product-btn-danger" disabled>
                                    Продуктът е изчерпан
                                </button>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    function increaseQty() {

        var input = document.getElementById("quantityInput");
        input.value = parseInt(input.value) + 1;

    }

    function decreaseQty() {

        var input = document.getElementById("quantityInput");

        if (input.value > 1) {
            input.value = parseInt(input.value) - 1;
        }

    }

</script>
<script>
    function increaseQty() {
        var input = document.getElementById("quantityInput");
        var max = parseInt(input.max) || 1;
        var current = parseInt(input.value) || 1;

        if (current < max) {
            input.value = current + 1;
        }
    }

    function decreaseQty() {
        var input = document.getElementById("quantityInput");
        var current = parseInt(input.value) || 1;

        if (current > 1) {
            input.value = current - 1;
        }
    }
</script>