@model IEnumerable<PowerFIt.Models.Order>

@{
    ViewData["Title"] = "Поръчки";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Моите поръчки</h1>
        <p class="page-subtitle">
            Преглед на всички направени поръчки в системата.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="cart-message">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>Все още няма направени поръчки.</h3>
        <p>След като поръчаш продукт, той ще се появи тук.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="order-card">
                    <div class="order-card-top">
                        <div class="order-badge">
                            Поръчка #@item.Id
                        </div>

                        <div class="order-date">
                            @item.OrderDate
                        </div>
                    </div>

                    <div class="order-card-body">
                        <h3 class="order-title">
                            @(item.Products?.Name ?? "Продукт")
                        </h3>

                        <div class="order-info-list">
                            <div><span>Количество:</span> @item.Quantity</div>
                            <div><span>Дата:</span> @item.OrderDate</div>
                            <div><span>Описание:</span> @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</div>
                        </div>
                    </div>

                    <div class="order-card-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn product-btn-secondary">
                            Детайли
                        </a>

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn product-btn-warning">
                            Редакция
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn product-btn-danger">
                            Изтрий
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}