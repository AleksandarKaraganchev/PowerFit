@model PowerFIt.Models.Category

@{
    ViewData["Title"] = "Изтриване на категория";
}

<div class="delete-page">

    <div class="page-header">
        <h1 class="page-title">Изтриване на категория</h1>
    </div>

    <div class="delete-card">

        <div class="delete-warning-box">
            <div class="delete-warning-title">Внимание</div>
            <p>Сигурен ли си, че искаш да изтриеш тази категория?</p>
        </div>

        <div class="delete-info-card">

            <div class="delete-info-grid">

                <div class="delete-info-item">
                    <span>Име</span>
                    <strong>@Model.Name</strong>
                </div>

                <div class="delete-info-item">
                    <span>Описание</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "Няма описание"
                                                : Model.Description)
                    </strong>
                </div>

            </div>

            <form asp-action="Delete" class="delete-actions">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn product-btn-danger">
                    Изтрий категорията
                </button>

                <a asp-action="Index" class="btn hero-btn-secondary">
                    Назад
                </a>

            </form>

        </div>

    </div>

</div>