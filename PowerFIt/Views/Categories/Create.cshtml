@model PowerFIt.Models.Category

@{
    ViewData["Title"] = "Добавяне на категория";
}

<div class="form-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Добавяне на нова категория</h1>
            <p class="page-subtitle">
                Създайте нова категория за продуктите.
            </p>
        </div>
    </div>

    <div class="product-form-card">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-field form-field-full">
                    <label asp-for="Name" class="form-label">Име на категория</label>
                    <input asp-for="Name" class="form-control custom-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" rows="4"
                              class="form-control custom-input custom-textarea"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="btn hero-btn-primary">
                    Запази категорията
                </button>

                <a asp-action="Index" class="btn hero-btn-secondary">
                    Назад
                </a>
            </div>

        </form>
    </div>
</div>