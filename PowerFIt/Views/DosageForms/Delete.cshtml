@model PowerFIt.Models.DosageForm

@{
    ViewData["Title"] = "Изтриване на форма";
}

<div class="delete-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Изтриване на форма</h1>
            <p class="page-subtitle">
                Потвърди изтриването на избраната форма.
            </p>
        </div>
    </div>

    <div class="delete-card">
        <div class="delete-warning-box">
            <div class="delete-warning-title">Внимание</div>
            <p>Сигурен ли си, че искаш да изтриеш тази форма?</p>
        </div>

        <div class="delete-info-card">
            <div class="delete-info-grid">
                <div class="delete-info-item">
                    <span>Име</span>
                    <strong>@Model.Name</strong>
                </div>

                <div class="delete-info-item">
                    <span>Описание</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "Няма описание"
                                                : Model.Description)
                    </strong>
                </div>
            </div>

            <form asp-action="Delete" class="delete-actions">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn product-btn-danger">Изтрий формата</button>
                <a asp-action="Index" class="btn hero-btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>