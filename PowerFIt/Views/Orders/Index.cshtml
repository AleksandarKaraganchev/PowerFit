@model IEnumerable<PowerFIt.Models.Order>

@{
    ViewData["Title"] = "Поръчки";
}

<div class="page-header">
    <div>
        @if (User.IsInRole("Admin"))
        {
            <h1 class="page-title">Всички поръчки</h1>
        }
        else
        {
            <h1 class="page-title">Моите поръчки</h1>
        }
        @if (User.IsInRole("Admin"))
        {
            <p class="page-subtitle">Преглед на всички поръчки в системата.</p>
        }
        else
        {
            <p class="page-subtitle">Преглед на вашите поръчки.</p>
        }
    </div>
</div>
<div class="filter-panel">
    <form asp-action="Index" method="get" class="filter-form">
        <div class="filter-grid">
            <div class="filter-field filter-search-field">
                <label class="filter-label">Търсене по продукт</label>
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control custom-input filter-search-input"
                       placeholder="Търси по име на продукт..." />
            </div>

            <div class="filter-field">
                <label class="filter-label">Период</label>
                <select name="dateFilter" class="form-select custom-input">
                    <option value="">Всички</option>
                    <option value="today" selected="@(ViewBag.DateFilter == "today")">Днес</option>
                    <option value="week" selected="@(ViewBag.DateFilter == "week")">Последните 7 дни</option>
                    <option value="month" selected="@(ViewBag.DateFilter == "month")">Последния месец</option>
                </select>
            </div>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn hero-btn-primary">Филтрирай</button>
            <a asp-action="Index" class="btn hero-btn-secondary">Изчисти</a>
        </div>
    </form>
</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="cart-message">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>Все още няма направени поръчки.</h3>
        <p>След като поръчаш продукт, той ще се появи тук.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="order-card">
                    <div class="order-card-top">
                        <div class="order-badge">
                            Поръчка #@item.Id
                        </div>

                        <div class="order-date">
                            @item.OrderDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="order-card-body">
                        <h3 class="order-title">
                            @(item.Products?.Name ?? "Продукт")
                        </h3>

                        <div class="order-info-list">
                            <div><span>Потребител:</span> @(item.Customers?.UserName ?? "-")</div>
                            <div><span>Количество:</span> @item.Quantity</div>
                            <div><span>Дата:</span> @item.OrderDate</div>
                            <div><span>Описание:</span> @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</div>
                            <div><span>Единична цена:</span> @((item.UnitPrice ?? item.Products?.Price ?? 0).ToString("0.00")) €</div>
                            <div><span>Обща стойност:</span> @((item.TotalPrice ?? ((item.Products?.Price ?? 0) * item.Quantity)).ToString("0.00")) €</div>
                        </div>
                    </div>

                   
                </div>
            </div>
        }
    </div>
}