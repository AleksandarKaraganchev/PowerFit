@model IEnumerable<PowerFIt.Models.Order>

@{
    ViewData["Title"] = "Поръчки";
}

<div class="page-header">
    <div>
        @if (User.IsInRole("Admin"))
        {
            <h1 class="page-title">Всички поръчки</h1>
        }
        else
        {
            <h1 class="page-title">Моите поръчки</h1>
        }
        @if (User.IsInRole("Admin"))
        {
            <p class="page-subtitle">Преглед на всички поръчки в системата.</p>
        }
        else
        {
            <p class="page-subtitle">Преглед на вашите поръчки.</p>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="cart-message">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>Все още няма направени поръчки.</h3>
        <p>След като поръчаш продукт, той ще се появи тук.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="order-card">
                    <div class="order-card-top">
                        <div class="order-badge">
                            Поръчка #@item.Id
                        </div>

                        <div class="order-date">
                            @item.OrderDate
                        </div>
                    </div>

                    <div class="order-card-body">
                        <h3 class="order-title">
                            @(item.Products?.Name ?? "Продукт")
                        </h3>

                        <div class="order-info-list">
                            <div><span>Потребител:</span> @(item.Customers?.UserName ?? "-")</div>
                            <div><span>Количество:</span> @item.Quantity</div>
                            <div><span>Дата:</span> @item.OrderDate</div>
                            <div><span>Описание:</span> @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</div>
                        </div>
                    </div>

                   
                </div>
            </div>
        }
    </div>
}