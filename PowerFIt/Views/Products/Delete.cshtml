@model PowerFIt.Models.Product

@{
    ViewData["Title"] = "Изтриване на продукт";
}

<div class="delete-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Изтриване на продукт</h1>
            <p class="page-subtitle">
                Потвърди изтриването на избрания продукт от системата.
            </p>
        </div>
    </div>

    <div class="delete-card">
        <div class="delete-warning-box">
            <div class="delete-warning-title">Внимание</div>
            <p>
                Сигурен ли си, че искаш да изтриеш този продукт? Това действие не може да бъде отменено.
            </p>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="delete-image-card">
                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.Name" class="delete-product-image" />
                    }
                    else
                    {
                        <img src="/images/no-image.png" alt="Няма изображение" class="delete-product-image" />
                    }
                </div>
            </div>

            <div class="col-lg-7">
                <div class="delete-info-card">
                    <h2>Информация за продукта</h2>

                    <div class="delete-info-grid">
                        <div class="delete-info-item">
                            <span>Име</span>
                            <strong>@Model.Name</strong>
                        </div>

                        <div class="delete-info-item">
                            <span>Категория</span>
                            <strong>@(Model.Categories?.Name ?? "-")</strong>
                        </div>

                        <div class="delete-info-item">
                            <span>Форма</span>
                            <strong>@(Model.DosageForms?.Name ?? "-")</strong>
                        </div>

                        <div class="delete-info-item">
                            <span>Цена</span>
                            <strong>@Model.Price.ToString("0.00") лв.</strong>
                        </div>
                    </div>

                    <div class="delete-description-box">
                        <h3>Описание</h3>
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p>@Model.Description</p>
                        }
                        else
                        {
                            <p>Няма добавено описание за този продукт.</p>
                        }
                    </div>

                    <form asp-action="Delete" class="delete-actions">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn product-btn-danger">Изтрий продукта</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn product-btn-secondary">Към детайли</a>
                        <a asp-action="Index" class="btn hero-btn-secondary">Назад към продуктите</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>