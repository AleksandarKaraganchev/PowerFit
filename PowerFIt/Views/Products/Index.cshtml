@model IEnumerable<PowerFIt.Models.Product>

@{
    ViewData["Title"] = "Продукти";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Продукти</h1>
        <p class="page-subtitle">
            Разгледайте наличните фитнес добавки по категории, форми и предпочитания.
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div>
            <a asp-action="Create" class="btn hero-btn-primary">+ Добави нов продукт</a>
        </div>
    }
</div>

<div class="filter-panel">
    <form asp-action="Index" method="get" class="filter-form">
        <div class="filter-grid">
            <div class="filter-field filter-search-field">
                <label class="filter-label">Търсене</label>
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control custom-input filter-search-input"
                       placeholder="Търси по име или описание..." />
            </div>

            <div class="filter-field">
                <label class="filter-label">Категория</label>
                <select name="categoryId" class="form-select custom-input" asp-items="ViewBag.Categories">
                    <option value="">Всички категории</option>
                </select>
            </div>

            <div class="filter-field">
                <label class="filter-label">Форма</label>
                <select name="dosageFormId" class="form-select custom-input" asp-items="ViewBag.DosageForms">
                    <option value="">Всички форми</option>
                </select>
            </div>
            <div class="filter-field">
                <label class="filter-label">Предназначение</label>
                <select name="recommendedFor" class="form-select custom-input" asp-items="ViewBag.RecommendedForOptions">
                    <option value="">Всички предназначения</option>
                </select>
            </div>
            <div class="filter-field">
                <label class="filter-label">Сортиране</label>
                <select name="sortOrder" class="form-select custom-input">
                    <option value="">Име (А-Я)</option>
                    <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc")">Име (Я-А)</option>
                    <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Цена възходящо</option>
                    <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Цена низходящо</option>
                </select>
            </div>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn hero-btn-primary">Филтрирай</button>
            <a asp-action="Index" class="btn hero-btn-secondary">Изчисти</a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>Няма намерени продукти.</h3>
        <p>Опитай с други критерии за търсене или филтриране.</p>
    </div>
}
else
{
    <div class="products-result-bar">
        <span>Намерени продукти: <strong>@Model.Count()</strong></span>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="product-card">

                    <div class="product-image-wrapper">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@item.Image" alt="@item.Name" class="product-image" />
                        }
                        else
                        {
                            <img src="/images/no-image.png" alt="Няма изображение" class="product-image" />
                        }
                    </div>

                    <div class="product-card-top">
                        <div class="product-badge">
                            @(item.Categories?.Name ?? "Категория")
                        </div>

                        <div class="product-type">
                            @(item.DosageForms?.Name ?? "Форма")
                        </div>
                    </div>
                    <div class="product-price-badge">
                        @item.Price.ToString("0.00") €
                    </div>
                    <div class="product-card-body">
                        <h3 class="product-title">@item.Name</h3>

                        <div class="product-meta">
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p>
                                    @(item.Description.Length > 120
                                                            ? item.Description.Substring(0, 120) + "..."
                                                            : item.Description)
                    </p>
                                        }
                            else
                            {
                                <p>Няма добавено описание за този продукт.</p>
                            }

                        </div>

                        <div class="product-info-list">
                            <div><span>Цена:</span> @item.Price.ToString("0.00")€.</div>
                            <div><span>Категория:</span> @(item.Categories?.Name ?? "-")</div>
                            <div><span>Форма:</span> @(item.DosageForms?.Name ?? "-")</div>
                            <div><span>Наличност:</span> @item.Quantity бр.</div>
                            <div><span>Предназначение: </span>@(string.IsNullOrWhiteSpace(item.RecommendedFor) ? "-" : item.RecommendedFor)</div>
                        </div>
                        @if (item.Quantity <= 5 && item.Quantity > 0)
                        {
                            <div class="low-stock-badge">
                                ⚠ Остават малко бройки!
                            </div>
                        }
                    </div>

                    <div class="product-card-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn product-btn-secondary">
                            Детайли
                        </a>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            if (item.Quantity > 0)
                            {
                                <form asp-controller="Checkout" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn hero-btn-primary">
                                        Поръчай
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn product-btn-danger" disabled>
                                    Изчерпан
                                </button>
                            }
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            if (item.Quantity > 0)
                            {
                                <form asp-controller="Checkout" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn hero-btn-primary">
                                        Поръчай
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn product-btn-danger" disabled>
                                    Изчерпан
                                </button>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn product-btn-warning">
                                Редакция
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn product-btn-danger">
                                Изтрий
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}