@model PowerFIt.Models.DosageForm

@{
    ViewData["Title"] = "Детайли за форма";
}

<div class="details-page">

    <div class="details-header">
        <div>
            <div class="details-badge">
                Форма на продукт
            </div>

            <h1 class="details-title">@Model.Name</h1>

            <p class="details-subtitle">
                Подробна информация за формата на добавките.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="details-info-card">

                <h2>Информация</h2>

                <div class="details-info-grid">

                    <div class="details-info-item">
                        <span>Име</span>
                        <strong>@Model.Name</strong>
                    </div>

                    <div class="details-info-item">
                        <span>Описание</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                                        ? "Няма описание"
                                                        : Model.Description)
                        </strong>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="details-info-card">

                <h2>Описание</h2>

                <div class="details-description-box">

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p>Няма добавено описание за тази форма.</p>
                    }

                </div>

                <div class="details-actions">

                    <a asp-action="Index" class="btn hero-btn-secondary">
                        Назад към формите
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn product-btn-warning">
                            Редакция
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model.Id"
                           class="btn product-btn-danger">
                            Изтрий
                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>